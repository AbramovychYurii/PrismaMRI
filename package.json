{
  "name": "prisma-mri",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "mcp-server"
  ],
  "scripts": {
    "dev": "vite",
    "build:dxt": "node scripts/build-dxt.mjs",
    "build": "npm run build:dxt && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check src && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write src",
    "typecheck": "tsc -b --noEmit && npm run typecheck -w mcp-server",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "ref:capture": "vite build && playwright test -c e2e/reference/playwright.config.ts render ui-chrome --update-snapshots=all",
    "ref:check": "vite build && playwright test -c e2e/reference/playwright.config.ts render ui-chrome",
    "ref:perf": "vite build && playwright test -c e2e/reference/playwright.config.ts perf",
    "research": "RESEARCH=1 vitest run research/benchmark.test.ts",
    "research:write": "RESEARCH=1 RESEARCH_WRITE=1 vitest run research/benchmark.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "styled-components": "^6.6.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^4.3.3",
    "esbuild": "^0.25.12",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  }
}
