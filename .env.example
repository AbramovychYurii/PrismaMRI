# ── PrismaMRI environment configuration ─────────────────────────────────────
#
# VITE_RELAY_URL  (required for AI Agent features)
#   Base URL of your deployed Cloudflare Worker relay.
#   Run `npx wrangler deploy` inside cloudflare-worker/ to get this URL.
#
#   The relay is a stateless WebSocket bridge — it forwards commands between
#   Claude Desktop (MCP server) and this browser tab. No data is stored.
#
VITE_RELAY_URL=https://<your-worker-name>.<your-account>.workers.dev
